#!/bin/sh
set -e

MSG_FILE="$1"

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "[ERROR] 커밋 메시지 파일이 존재하지 않습니다."
    exit 1
fi

# Python 스크립트를 통한 엄격한 컨벤션 검증 (UTF-8 한글 및 마침표 검사)
python - "$MSG_FILE" << 'EOF'
import sys
import re

msg_file = sys.argv[1]
with open(msg_file, "r", encoding="utf-8") as f:
    lines = [line.strip() for line in f.readlines() if line.strip() and not line.startswith("#")]

if not lines:
    print("[ERROR] 커밋 메시지가 비어 있습니다.")
    sys.exit(1)

subject = lines[0]

# 정규식 패턴: <type>(<scope>): <한글 요약> 또는 <type>: <한글 요약>
pattern = r"^(feat|fix|refactor|docs|chore|test|style|perf|ci)(\([a-z0-9_\-\/]+\))?!?: (.+)$"
match = re.match(pattern, subject)

if not match:
    print("[ERROR] 커밋 메시지 규격 위반!")
    print("형식: <type>(<scope>): <한글 요약>")
    print("허용 Type: feat, fix, refactor, docs, chore, test, style, perf, ci")
    print(f"입력된 메시지: '{subject}'")
    sys.exit(1)

content = match.group(3).strip()

# 끝 마침표 금지
if content.endswith("."):
    print("[ERROR] 커밋 제목 끝에는 마침표(.)를 사용할 수 없습니다.")
    print(f"입력된 메시지: '{subject}'")
    sys.exit(1)

# 한국어(한글 음절 또는 자모) 포함 검증
has_hangul = bool(re.search(r"[\uac00-\ud7a3\u3131-\u318e]", content))
if not has_hangul:
    print("[ERROR] 커밋 메시지 요약은 명확한 한국어(한글)로 작성해야 합니다.")
    print(f"입력된 메시지: '{subject}'")
    sys.exit(1)

print("[commit-msg] 커밋 메시지 컨벤션 검증 통과.")
sys.exit(0)
EOF

exit $?
