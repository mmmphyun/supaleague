#!/bin/sh
set -e

echo "[pre-commit] 로컬 하드 가드 사전 검증 시작..."

# 1. 브랜치 검증: main 브랜치 직접 커밋 차단
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)

if git rev-parse --verify HEAD >/dev/null 2>&1; then
    HAS_COMMITS=1
else
    HAS_COMMITS=0
fi

if [ "$BRANCH" = "main" ] && [ "$HAS_COMMITS" -eq 1 ]; then
    echo "[ERROR] 'main' 브랜치에 직접 커밋할 수 없습니다."
    echo "작업 브랜치를 생성하십시오: git checkout -b feat/<work-name>"
    exit 1
fi

# 1.1 브랜치 네이밍 컨벤션 검증 (main 제외)
if [ "$BRANCH" != "main" ]; then
    VALID_BRANCH_REGEX='^(feat|fix|refactor|docs|chore|test|style|perf|ci|infra|hotfix)/[a-z0-9_\-]+$'
    if ! echo "$BRANCH" | grep -Eq "$VALID_BRANCH_REGEX"; then
        echo "[ERROR] 브랜치 명명 규칙 위반: '$BRANCH'"
        echo "형식: <type>/<work-name> (소문자 영문, 숫자, 하이픈, 언더스코어)"
        echo "허용 Type: feat, fix, refactor, docs, chore, test, style, perf, ci, infra, hotfix"
        echo "예시: feat/player-stamina, infra/docker-bridge, fix/ball-tunneling"
        exit 1
    fi
fi

# 2. 이미 머지된 브랜치 재사용 방어 (Stale Branch Guard) 및 이전 작업 브랜치 파생 방어
if [ "$HAS_COMMITS" -eq 1 ] && [ "$BRANCH" != "main" ]; then
    if git rev-parse --verify main >/dev/null 2>&1; then
        HEAD_SHA=$(git rev-parse HEAD)
        MAIN_SHA=$(git rev-parse main)
        # HEAD가 main과 완전히 같으면 main에서 새로 분기된 신규 작업 브랜치이므로 허용
        if [ "$HEAD_SHA" != "$MAIN_SHA" ]; then
            if git merge-base --is-ancestor HEAD main; then
                echo "[ERROR] 현재 브랜치('$BRANCH')는 이미 'main'에 머지된 종료 브랜치입니다."
                echo "종료된 브랜치에서의 추가 작업은 브랜치 오염을 유발합니다."
                echo "최신 main으로 이동 후 새 브랜치를 분기하십시오:"
                echo "  git checkout main && git pull origin main && git checkout -b feat/<work-name>"
                exit 1
            fi
        fi

        # 다른 미머지 로컬 브랜치로부터 파생되었는지 검사 (Branch Chaining Guard)
        OTHER_BRANCHES=$(git for-each-ref --format='%(refname:short)' refs/heads/ | grep -v -E "^(main|$BRANCH)$" || true)
        for other in $OTHER_BRANCHES; do
            if git merge-base --is-ancestor "$other" HEAD; then
                if ! git merge-base --is-ancestor "$other" main; then
                    echo "[ERROR] 브랜치 오염 감지: 현재 브랜치는 미머지 브랜치('$other')에서 파생되었습니다."
                    echo "새 작업은 반드시 'main'에서 직접 분기해야 합니다:"
                    echo "  git checkout main && git checkout -b feat/<work-name>"
                    exit 1
                fi
            fi
        done
    fi
fi

# 3. 보안 검증: 시크릿 / 비밀키 파일 유출 차단 (.githooks 디렉토리 자체는 제외)
FORBIDDEN_FILES='(\.env$|\.secret$|\.key$|\.pem$|id_rsa|velocity\.secret)'
STAGED_FILES=$(git diff --cached --name-only -- . ':(exclude).githooks')

for file in $STAGED_FILES; do
    if echo "$file" | grep -Eq "$FORBIDDEN_FILES"; then
        echo "[ERROR] 보안 위반: 시크릿 파일('$file')이 커밋 대상에 포함되어 있습니다."
        exit 1
    fi
done

if git diff --cached -S"BEGIN"" PRIVATE KEY" --name-only -- . ':(exclude).githooks' | grep -q .; then
    echo "[ERROR] 보안 위반: Staged 코드 내 비공개 키(Private Key)가 탐지되었습니다."
    exit 1
fi

# 4. 대용량 바이너리(5MB 초과) 및 서버 파일 유입 차단 (gradle-wrapper.jar 제외)
MAX_FILE_SIZE=5242880 # 5MB
FORBIDDEN_EXT='(\.jar$|\.mca$|\.tar\.gz$|\.zip$)'
for file in $STAGED_FILES; do
    if [ "$file" = "gradle/wrapper/gradle-wrapper.jar" ]; then
        continue
    fi
    if echo "$file" | grep -Eq "$FORBIDDEN_EXT"; then
        echo "[ERROR] 바이너리 유입 위반: 차단된 파일 형식('$file')입니다."
        echo "서버 Jar 및 월드 데이터(.mca)는 Git에 커밋할 수 없습니다."
        exit 1
    fi
    # 5MB 초과 파일 크기 검사 (git cat-file 사용)
    if [ -f "$file" ]; then
        FILE_SIZE=$(git cat-file -s ":$file" 2>/dev/null || wc -c < "$file" 2>/dev/null || echo 0)
        if [ "$FILE_SIZE" -gt "$MAX_FILE_SIZE" ]; then
            echo "[ERROR] 대용량 파일 유입 위반: '$file' (${FILE_SIZE} bytes > 5MB)"
            echo "5MB를 초과하는 바이너리나 대용량 파일은 Git에 직접 커밋할 수 없습니다."
            exit 1
        fi
    fi
done

# 4.1 코어 도메인 소스 코드 레벨 Paper/Bukkit/Velocity import 정적 차단
FORBIDDEN_IMPORTS='(import\s+(org\.bukkit|io\.papermc|com\.velocitypowered))'
CORE_SOURCE_FILES=$(echo "$STAGED_FILES" | grep -E '^core/.+\.(kt|java)$' || true)
for cfile in $CORE_SOURCE_FILES; do
    if [ -f "$cfile" ]; then
        if grep -Eq "$FORBIDDEN_IMPORTS" "$cfile"; then
            echo "[ERROR] 도메인 순수성 위반: '$cfile' 내 금지된 패키지 import 탐지!"
            echo "core/* 모듈은 순수 Kotlin/JVM이어야 하며 Bukkit, Paper, Velocity를 import할 수 없습니다."
            exit 1
        fi
    fi
done

# 5. Fast-Feedback: 순수 JVM 도메인 단위 테스트 (:core:physics, :core:stats)
if [ -f "./gradlew.bat" ] || [ -f "./gradlew" ]; then
    AFFECTED_CORE=$(echo "$STAGED_FILES" | grep -E '^(core/|build\.gradle|settings\.gradle)' || true)
    if [ -n "$AFFECTED_CORE" ]; then
        echo "[pre-commit] 순수 JVM 도메인 단위 테스트 고속 실행 중..."
        if [ -f "./gradlew.bat" ]; then
            cmd.exe /c "gradlew.bat checkDomainPurity :core:physics:test :core:stats:test --daemon -q"
        else
            ./gradlew checkDomainPurity :core:physics:test :core:stats:test --daemon -q
        fi
        if [ $? -ne 0 ]; then
            echo "[ERROR] 순수 도메인 단위 테스트 실패! 오류를 해결한 후 커밋하십시오."
            exit 1
        fi
    fi
fi

echo "[pre-commit] 모든 사전 검증 통과."
exit 0
